{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/auth/route.ts": { "maxDuration": 30 },
    "app/api/build/route.ts": { "maxDuration": 30 },
    "app/api/status/route.ts": { "maxDuration": 10 },
    "app/api/webhook/route.ts": { "maxDuration": 30 },
    "app/api/projects/route.ts": { "maxDuration": 10 },
    "app/api/governance/route.ts": { "maxDuration": 30 },
    "app/api/setup/route.ts": { "maxDuration": 30 },
    "app/api/admin/route.ts": { "maxDuration": 10 },
    "app/api/schedules/route.ts": { "maxDuration": 10 },
    "app/api/schedules/[id]/route.ts": { "maxDuration": 10 },
    "app/api/upload/route.ts": { "maxDuration": 60 },
    "app/api/cron/governance/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/governance", "schedule": "0 * * * *" }
  ]
}
