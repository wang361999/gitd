// Agent Forge Prisma Schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

enum ProjectStatus {
  draft
  building
  governing
  packaging
  done
  failed
}

enum TaskStage {
  generate
  governance
  package
}

enum TaskStatus {
  pending
  running
  success
  failed
}

// ============ 数据表 ============

/// 系统配置表 — 存储所有环境变量，部署后自动落库
model Setting {
  key       String   @id
  value     String   @db.Text
  category  String   @default("general") // github | app | security
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model User {
  id          String   @id @default(cuid())
  githubId    Int     @unique
  username    String
  email       String?
  avatarUrl   String?
  accessToken String
  createdAt   DateTime @default(now())

  projects    Project[]
  schedules   GovernanceSchedule[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @db.Text
  projectType String   @default("web") // web | desktop | mobile
  repoUrl     String?
  repoOwner   String?
  repoName    String?
  previewUrl  String?
  downloadUrl String?
  status      ProjectStatus @default(draft)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  governanceReports GovernanceReport[]
  loreRecords LoreRecord[]
  versions    Version[]
  architecturePlans ArchitecturePlan[]
  codeReviews       CodeReview[]
  chatSessions      ChatSession[]
  refactorings      Refactoring[]
  bugFixes          BugFix[]
  performanceReports PerformanceReport[]

  @@map("projects")
}

model Task {
  id            String   @id @default(cuid())
  projectId     String
  stage         TaskStage
  status        TaskStatus @default(pending)
  log           String?  @db.Text
  result        Json?
  actionsRunId  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  governanceReports GovernanceReport[]

  @@map("tasks")
}

model GovernanceReport {
  id          String   @id @default(cuid())
  taskId      String
  projectId   String
  filePath    String
  source      String   // human | ai:gpt-4o | ai:llama-4 etc
  modelName   String?
  lineCount   Int      @default(0)
  riskScore   Float    @default(0)
  issues      Json     // { type, severity, line, description, suggestion }[]
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("governance_reports")
}

model LoreRecord {
  id          String   @id @default(cuid())
  projectId   String
  commitSha   String
  context     String   @db.Text
  decision    String   @db.Text
  rejected    String?  @db.Text
  constraints String?  @db.Text
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("lore_records")
}

model Version {
  id          String   @id @default(cuid())
  projectId   String
  versionTag  String
  releaseUrl  String?
  downloadUrl String?
  releaseNotes String? @db.Text
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("versions")
}

/// 定时治理计划 — 用户配置的自动治理任务
model GovernanceSchedule {
  id          String   @id @default(cuid())
  userId      String
  repoOwner   String
  repoName    String
  frequency   String   @default("weekly") // daily | weekly | monthly
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("governance_schedules")
}

// v0.2.0: 架构设计记录
model ArchitecturePlan {
  id           String   @id @default(cuid())
  projectId    String
  summary      String   @db.Text
  techStack    Json
  fileStructure Json
  codingRules  Json
  dependencies Json
  architecture Json?
  testingStrategy String? @db.Text
  securityConsiderations String? @db.Text
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("architecture_plans")
}

// v0.2.0: AI 代码审查记录
model CodeReview {
  id            String   @id @default(cuid())
  taskId        String?
  projectId     String
  overallScore  Int      @default(0)
  dimensions    Json     // { functionality, quality, performance, security, robustness }
  issues        Json     // [{ type, severity, file, message, suggestion }]
  fixedIssues   Int      @default(0)
  reviewModel   String?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("code_reviews")
}

// v0.3.0: AI 对话记录
model ChatSession {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  title       String   @default("新对话")
  messages    Json     // [{ role, content, fileContext, timestamp }]
  model       String   @default("gpt-4o")
  contextFiles Json?   // ["file1.ts", "file2.ts"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("chat_sessions")
}

// v0.4.0: 重构记录
model Refactoring {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // extract-method, extract-class, rename, etc.
  filePath    String
  beforeCode  String   @db.Text
  afterCode   String   @db.Text
  reason      String   @db.Text
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("refactorings")
}

// v0.4.0: Bug 修复记录
model BugFix {
  id          String   @id @default(cuid())
  projectId   String
  errorLog    String   @db.Text
  rootCause   String   @db.Text
  fixCode     String   @db.Text
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("bug_fixes")
}

// v0.4.0: 性能分析记录
model PerformanceReport {
  id          String   @id @default(cuid())
  projectId   String
  score       Int      @default(0)
  issues      Json     // [{ type, severity, file, description, suggestion }]
  optimizations Json   // [{ category, impact, description }]
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("performance_reports")
}

// v1.0.0: 自定义 AI Agent
model CustomAgent {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?  @db.Text
  systemPrompt  String   @db.Text
  tools         Json     // ["code-gen", "review", "test", "refactor", "bugfix"]
  knowledgeBase Json?    // { entries: [{ question, answer }] }
  model         String   @default("gpt-4o")
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("custom_agents")
}

// v1.0.0: 知识库
model KnowledgeEntry {
  id          String   @id @default(cuid())
  projectId   String?
  agentId     String?
  category    String   @default("general") // architecture, bug, decision, convention
  question    String   @db.Text
  answer      String   @db.Text
  source      String?  // commit, manual, ai-generated
  createdAt   DateTime @default(now())
  @@map("knowledge_entries")
}

// v1.0.0: 分析事件
model AnalyticsEvent {
  id          String   @id @default(cuid())
  userId      String?
  projectId   String?
  eventType   String   // code-generated, code-reviewed, bug-fixed, refactored, chat-message
  model       String?
  tokensUsed  Int      @default(0)
  duration    Int      @default(0) // milliseconds
  metadata    Json?
  createdAt   DateTime @default(now())
  @@map("analytics_events")
}
